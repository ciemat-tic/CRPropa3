+	exactFutureRedshift.process(&c);
+
+	EXPECT_GT(z0, z1);
+	EXPECT_NEAR(z0, c.getRedshift(), 5e-6);
+	EXPECT_NEAR(E0, c.current.getEnergy(), E0 * 5e-6);
+	EXPECT_LT(E1, E0);
+}

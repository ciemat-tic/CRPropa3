 	 @returns Rigidity of the particle [in Volts]
 	 */
 	double getRigidity() const;
@@ -104,6 +108,31 @@ public:
 	 */
 	double getLorentzFactor() const;
 
+
+	/** Get beta = v/c.
+	 Returns 1 for massless particles. For massive particles with energy <= m c^2,
+	 returns 0.
+	 */
